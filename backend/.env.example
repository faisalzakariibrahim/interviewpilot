# InterviewPilot backend settings. Copy to .env (the launcher does this for you).

# Your Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: the Claude model that plans and scores. Default: claude-sonnet-5-5
F2F_MODEL=

# Optional: reads job-posting links. From https://www.firecrawl.dev/app/api-keys
# Without it, links are read directly (works for most simple job pages).
FIRECRAWL_API_KEY=

# --- Cloud paid mode only (used by ./deploy-cloud.sh, ignored locally) ---
# Stripe secret key. Start with a test key (sk_test_...) from
# https://dashboard.stripe.com/test/apikeys ; switch to sk_live_ when ready.
STRIPE_SECRET_KEY=
# Supabase service-role key (Project Settings > API keys). Used only to add
# credits after Stripe confirms a payment. Never put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=
